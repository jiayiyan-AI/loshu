{
  "specFormat": "schema/v1",
  "meta": {
    "name": "项目跟踪",
    "description": "洛书示例 schema：客户 / 项目 / 任务三张表，配套视图与总览仪表盘。用来演示 SchemaDefinition 各构件长什么样，非真实数据。"
  },

  "tables": {
    "tbl_customer": {
      "name": "客户",
      "primaryField": "fld_cust_name",
      "fields": {
        "fld_cust_name":     { "kind": "text",   "name": "客户名", "format": { "kind": "plain" }, "required": true, "unique": true },
        "fld_cust_industry": { "kind": "select", "name": "行业",
          "options": {
            "opt_it":  { "name": "IT",   "color": "blue"   },
            "opt_fin": { "name": "金融", "color": "green"  },
            "opt_edu": { "name": "教育", "color": "orange" }
          }
        },
        "fld_cust_owner":   { "kind": "user", "name": "客户经理", "subject": "member" },
        "fld_cust_site":    { "kind": "text", "name": "官网", "format": { "kind": "url", "allowedSchemes": ["https"] } },
        "fld_cust_created": { "kind": "createdAt", "name": "建档时间" }
      }
    },

    "tbl_project": {
      "name": "项目",
      "primaryField": "fld_proj_name",
      "fields": {
        "fld_proj_name":     { "kind": "text",     "name": "项目名", "format": { "kind": "plain" }, "required": true },
        "fld_proj_customer": { "kind": "relation", "name": "所属客户", "target": "tbl_customer", "onDelete": "restrict" },
        "fld_proj_status":   { "kind": "select",   "name": "状态",
          "options": {
            "opt_active": { "name": "进行中", "color": "blue"  },
            "opt_done":   { "name": "已完成", "color": "green" },
            "opt_hold":   { "name": "搁置",   "color": "gray"  }
          }
        },
        "fld_proj_start":  { "kind": "date",   "name": "开始日期" },
        "fld_proj_budget": { "kind": "number", "name": "预算", "format": { "kind": "currency", "currencyCode": "CNY", "precision": 2 }, "minimum": 0 }
      }
    },

    "tbl_task": {
      "name": "任务",
      "primaryField": "fld_task_title",
      "fields": {
        "fld_task_title":    { "kind": "text",     "name": "标题", "format": { "kind": "plain" }, "required": true },
        "fld_task_project":  { "kind": "relation", "name": "所属项目", "target": "tbl_project", "onDelete": "cascade" },
        "fld_task_assignee": { "kind": "user",     "name": "负责人", "subject": "member" },
        "fld_task_status":   { "kind": "select",   "name": "状态",
          "options": {
            "opt_todo":  { "name": "待办",   "color": "gray"   },
            "opt_doing": { "name": "进行中", "color": "blue"   },
            "opt_done":  { "name": "已完成", "color": "green"  }
          }
        },
        "fld_task_priority": { "kind": "number",  "name": "优先级", "format": { "kind": "rating", "max": 5 } },
        "fld_task_progress": { "kind": "number",  "name": "完成度", "format": { "kind": "progress" } },
        "fld_task_due":      { "kind": "date",    "name": "截止日" },
        "fld_task_deps":     { "kind": "relation","name": "前置任务", "target": "tbl_task", "multiple": true, "onDelete": "setNull" },
        "fld_task_weight":   { "kind": "formula", "name": "加权分", "expression": "fld_task_priority * (100 - fld_task_progress)" },
        "fld_task_created":  { "kind": "createdAt", "name": "创建时间" }
      }
    }
  },

  "views": {
    "view_task_open": {
      "name": "未完成任务",
      "source": { "table": "tbl_task" },
      "joins": {
        "j_project": { "via": ["fld_task_project"], "field": "fld_proj_name" },
        "j_customer": { "via": ["fld_task_project", "fld_proj_customer"], "field": "fld_cust_name" }
      },
      "filter": { "fld_task_status": { "$ne": "opt_done" } },
      "sort": [{ "field": "fld_task_due", "direction": "asc" }],
      "presentation": {
        "kind": "grid",
        "order": ["fld_task_title", "j_project", "j_customer", "fld_task_assignee", "fld_task_status", "fld_task_progress", "fld_task_due"],
        "columns": {
          "fld_task_progress": { "width": 120 },
          "fld_task_created": { "hidden": true }
        },
        "frozen": 1,
        "rowHeight": "medium"
      }
    },

    "view_task_board": {
      "name": "任务看板",
      "source": { "table": "tbl_task" },
      "sort": [{ "field": "fld_task_priority", "direction": "desc" }],
      "presentation": {
        "kind": "kanban",
        "groupBy": "fld_task_status",
        "order": ["fld_task_title", "fld_task_assignee", "fld_task_due", "fld_task_priority"]
      }
    },

    "view_project_list": {
      "name": "项目清单",
      "source": { "table": "tbl_project" },
      "joins": {
        "j_owner_customer": { "via": ["fld_proj_customer"], "field": "fld_cust_name" }
      },
      "aggregates": {
        "agg_task_count": { "via": "fld_task_project", "aggregation": "count" },
        "agg_task_done":  { "via": "fld_task_project", "aggregation": "count", "filter": { "fld_task_status": "opt_done" } }
      },
      "computed": {
        "c_done_rate": { "expression": "agg_task_count > 0 ? agg_task_done / agg_task_count : 0" }
      },
      "sort": [{ "field": "agg_task_count", "direction": "desc" }],
      "presentation": {
        "kind": "grid",
        "order": ["fld_proj_name", "j_owner_customer", "fld_proj_status", "agg_task_count", "agg_task_done", "c_done_rate", "fld_proj_budget"],
        "columns": {
          "c_done_rate": { "precision": 0 }
        },
        "frozen": 1
      }
    },

    "view_project_entry": {
      "name": "新建项目",
      "source": { "table": "tbl_project" },
      "presentation": {
        "kind": "form",
        "submitLabel": "创建项目",
        "items": [
          { "field": "fld_proj_name", "required": true },
          { "field": "fld_proj_customer", "required": true, "help": "先在「客户」表里建好客户" },
          { "field": "fld_proj_status" },
          { "field": "fld_proj_start" },
          { "field": "fld_proj_budget", "help": "含税总预算，单位元" }
        ]
      }
    }
  },

  "dashboards": {
    "dash_overview": {
      "name": "总览",
      "widgets": {
        "wgt_total_projects": {
          "title": "项目总数",
          "query": { "table": "tbl_project", "measures": [{ "id": "m_count", "aggregation": "count" }] },
          "chart": { "kind": "metric", "value": "m_count" }
        },
        "wgt_by_status": {
          "title": "各状态项目数",
          "query": {
            "table": "tbl_project",
            "dimensions": [{ "id": "d_status", "field": "fld_proj_status" }],
            "measures": [{ "id": "m_count", "aggregation": "count" }]
          },
          "chart": { "kind": "bar", "x": "d_status", "y": ["m_count"] }
        },
        "wgt_by_industry": {
          "title": "客户行业分布",
          "query": {
            "table": "tbl_customer",
            "dimensions": [{ "id": "d_industry", "field": "fld_cust_industry" }],
            "measures": [{ "id": "m_count", "aggregation": "count" }]
          },
          "chart": { "kind": "donut", "category": "d_industry", "value": "m_count" }
        },
        "wgt_tasks_monthly": {
          "title": "每月新建任务",
          "query": {
            "table": "tbl_task",
            "dimensions": [{ "id": "d_month", "field": "fld_task_created", "bucket": "month" }],
            "measures": [{ "id": "m_count", "aggregation": "count" }]
          },
          "chart": { "kind": "line", "x": "d_month", "y": ["m_count"] }
        },
        "wgt_budget_by_customer": {
          "title": "各客户项目数与预算",
          "query": {
            "table": "tbl_project",
            "dimensions": [{ "id": "d_customer", "field": "fld_proj_customer" }],
            "measures": [
              { "id": "m_projects", "aggregation": "count" },
              { "id": "m_budget", "aggregation": "sum", "field": "fld_proj_budget" }
            ],
            "having": [{ "measure": "m_projects", "condition": { "$gte": 1 } }]
          },
          "chart": { "kind": "table" }
        }
      },
      "layout": {
        "wgt_total_projects":    { "x": 0, "y": 0, "w": 3, "h": 2 },
        "wgt_by_status":         { "x": 3, "y": 0, "w": 9, "h": 4 },
        "wgt_by_industry":       { "x": 0, "y": 2, "w": 3, "h": 4 },
        "wgt_tasks_monthly":     { "x": 0, "y": 6, "w": 6, "h": 4 },
        "wgt_budget_by_customer":{ "x": 6, "y": 6, "w": 6, "h": 4 }
      }
    }
  }
}
